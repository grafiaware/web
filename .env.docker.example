# Zkopírujte jako `.env` v kořeni repo (Docker Compose ho načte automaticky).
# Soubor `.env` necommitujte.

COMPOSE_PROJECT_NAME=grafia-web

# --- Verze stacku (varianty do budoucna) ---
# PHP: 8.4 (výchozí), případně 8.3 pokud máte Dockerfile kompatibilní image
PHP_VERSION=8.4
# DB: MariaDB (blízko produkci) nebo MySQL 8 pro vývoj migrací
DB_IMAGE=mariadb:11.4
# DB_IMAGE=mysql:8.0

# --- Porty na hostu (0.0.0.0 = dostupné z LAN) ---
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443
DB_PORT=3306
MAIL_UI_PORT=5000
MAIL_SMTP_PORT=25

# --- HTTPS / LAN ---
# Hostname posílaný Apache (volitelné)
WEB_SERVER_NAME=web.local
# Pro generate-certs.sh — vaše LAN IP (nebo nechte prázdné, skript zkusí detekci)
WEB_LAN_IP=
WEB_CERT_HOSTS=localhost,web.local,grafia.local

# Playwright base URL (host → kontejner web)
PLAYWRIGHT_BASE_URL=https://host.docker.internal
