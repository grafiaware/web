# Zkopírujte jako `.env` v kořeni repo (Docker Compose ho načte automaticky).
# Soubor `.env` necommitujte.

COMPOSE_PROJECT_NAME=grafia-web

# --- Verze stacku (varianty do budoucna) ---
# PHP: 8.4 (výchozí), případně 8.3 pokud máte Dockerfile kompatibilní image
PHP_VERSION=8.4
# DB: MariaDB (blízko produkci) nebo MySQL 8 pro vývoj migrací
DB_IMAGE=mariadb:11.4
# DB_IMAGE=mysql:8.0

# --- Porty na hostu (0.0.0.0 = dostupné z LAN) ---
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443
DB_PORT=3306
MAIL_UI_PORT=5000
MAIL_SMTP_PORT=25

# --- Veřejné jméno tohoto vývojového stroje (QR, PDF, odkazy v e-mailech) ---
# Vyberte JEDNO jméno z WEB_DEV_HOSTS (mapujte ho v DNS/DHCP na LAN IP tohoto PC).
# ps = Petr, vs = …, ks = …
WEB_PUBLIC_HOST=ps.dev.local
WEB_PUBLIC_SCHEME=https

# Všechna vývojová jména týmu (certifikát SAN + Apache ServerAlias)
WEB_DEV_HOSTS=ps.dev.local,vs.dev.local,ks.dev.local

# --- HTTPS / certifikáty ---
# Hostname pro Apache (výchozí = WEB_PUBLIC_HOST)
WEB_SERVER_NAME=ps.dev.local
# Pro generate-certs — LAN IP (nebo nechte prázdné, skript zkusí detekci)
WEB_LAN_IP=
# Hosty v certifikátu: localhost + vývojová jména (nebo nechte prázdné = skript sestaví z WEB_DEV_HOSTS)
WEB_CERT_HOSTS=localhost,ps.dev.local,vs.dev.local,ks.dev.local

# Playwright base URL (host → kontejner web)
PLAYWRIGHT_BASE_URL=https://ps.dev.local
