        "pes/pes-core": "^8.27",
        "pes/pes-database": "^8.27",
        "pes/pes-di": "^8.27",
        "pes/pes-http": "^8.27",
        "pes/pes-logger": "^8.27",
        "pes/pes-mail": "^8.27",
        "pes/pes-model": "^8.27",
        "pes/pes-router": "^8.27",
        "pes/pes-session": "^8.27",
        "pes/pes-view": "^8.27",
        "phpmailer/phpmailer": "^6.2",
        "endroid/qr-code": "^6.1.0",
        "khanamiryan/qrcode-detector-decoder": "^2.0.3"
