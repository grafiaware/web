{
    "name": "grafiaware/web",
    "description": "web",
    "license": "MIT",
    "keywords": ["grafia"],
    "authors": [
        {
            "name": "Petr Svoboda",
            "email": "svoboda@grafia.cz"
        }
    ],
    "version": "8.0",
"repositories": [
    { "type": "path", "url": "../pes/pes-application", "options": { "symlink": true } },
    { "type": "path", "url": "../pes/pes-bootstrap", "options": { "symlink": true } },
    { "type": "path", "url": "../pes/pes-core", "options": { "symlink": true } },
    { "type": "path", "url": "../pes/pes-database", "options": { "symlink": true } },
    { "type": "path", "url": "../pes/pes-di", "options": { "symlink": true } },
    { "type": "path", "url": "../pes/pes-http", "options": { "symlink": true } },
    { "type": "path", "url": "../pes/pes-logger", "options": { "symlink": true } },
    { "type": "path", "url": "../pes/pes-router", "options": { "symlink": true } },
    { "type": "path", "url": "../pes/pes-session", "options": { "symlink": true } },
    { "type": "path", "url": "../pes/pes-view", "options": { "symlink": true } },
    { "type": "path", "url": "../pes/pes-model", "options": { "symlink": true } },
    { "type": "path", "url": "../pes/pes-mail", "options": { "symlink": true } }
],    
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.4",
        "pes/pes": "dev-split",
        "phpmailer/phpmailer": "^6.2",
        "endroid/qr-code": "^6.1.0",
        "khanamiryan/qrcode-detector-decoder": "^2.0.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "friendsofphp/php-cs-fixer": "^3.9.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Site\\": "app/Site",
            "Access\\": "src/Access",
            "Application\\": "src/Application",
            "Component\\": "src/Component",
            "Configuration\\": "src/Configuration",
            "Container\\": "src/Container",
            "FrontControler\\": "src/FrontControler",
            "Mail\\": "src/Mail",
            "Replace\\": "src/Replace",
            "StaticRegistry\\": "src/StaticRegistry",
            "Template\\": "src/Template",
            "View\\": "src/View",
            
            "Auth\\": "src/Module/Auth",
            "Build\\": "src/Module/Build",
            "Consent\\": "src/Module/Consent",
            "Events\\": "src/Module/Events",
            "Firewall\\": "src/Module/Firewall",
            "Ping\\": "src/Module/Ping",
            "Red\\": "src/Module/Red",
            "RequestLogger\\": "src/Module/RequestLogger",
            "ResponseTime\\": "src/Module/ResponseTime",
            "Sendmail\\": "src/Module/Sendmail",
            "Status\\": "src/Module/Status",
            "Transformator\\": "src/Module/Transformator",
            "Web\\": "src/Module/Web",

            "Test\\": "tests"
        }
    }
}
