            "Events\\": "src/Module/Events",
            "Firewall\\": "src/Module/Firewall",
            "Ping\\": "src/Module/Ping",
            "Red\\": "src/Module/Red",
            "RequestLogger\\": "src/Module/RequestLogger",
            "ResponseTime\\": "src/Module/ResponseTime",
            "Sendmail\\": "src/Module/Sendmail",
